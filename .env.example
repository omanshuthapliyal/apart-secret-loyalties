# Required by src/secret_loyalty/data_gen/scenarios.py (scenario brainstorming step).
OPENAI_API_KEY=

# Optional: override the OpenAI model used for scenario brainstorming (default: gpt-4.1-mini).
# OPENAI_SCENARIO_MODEL=gpt-4.1-mini

# Optional: override the OpenAI model used for judging (activation/audit evals).
# OPENAI_JUDGE_MODEL=gpt-4.1-mini

# GPU assignment is a --gpu N CLI flag (see scripts/run_pipeline.sh and
# scripts/run_both.sh), not an env var - configs/train.yaml's teacher.device /
# train_device are just the fallback defaults when --gpu isn't passed.
